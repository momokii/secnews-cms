{
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read(**)",
      "Write(**)",
      "Edit(**)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git pull:*)",
      "Bash(git clone:*)",
      "Bash(docker ps:*)",
      "Bash(docker logs:*)",
      "Bash(docker build:*)",
      "Bash(docker compose config:*)",
      "Bash(docker-compose config:*)",
      "Bash(docker-compose ps:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(touch:*)"
    ],
    "ask": [
      "Bash(git checkout:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git branch:*)",
      "Bash(docker:*)",
      "Bash(docker-compose:*)",
      "Bash(rm:*)",
      "Bash(make:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(yarn:*)",
      "Bash(pnpm:*)",
      "Bash(bun:*)",
      "Bash(pip:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(node:*)",
      "Bash(go:*)",
      "Bash(cargo:*)",
      "Bash(bundle:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(cat:*)",
      "Bash(echo:*)",
      "Bash(jq:*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~:*)",
      "Bash(sudo rm:*)",
      "Bash(sudo:*)",
      "Bash(curl:* | bash)",
      "Bash(curl:* | sh)",
      "Bash(wget:* | bash)",
      "Bash(wget:* | sh)",
      "Bash(chmod 777:*)",
      "Bash(dd if:*)",
      "Bash(mkfs:*)",
      "Bash(shutdown:*)",
      "Bash(reboot:*)",
      "Bash(:(){:|:&};:)",
      "Bash(git reset --hard:*)",
      "Bash(git clean -f:*)",
      "Bash(git push --force:*)",
      "Bash(docker system prune:*)",
      "Bash(docker volume rm:*)",
      "Bash(docker rmi -f:*)"
    ]
  }
}
