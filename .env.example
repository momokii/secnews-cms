# Universal .env.example — committed, non-secret placeholders
# Copy to .env and fill with real values. Never commit .env.
# See .claude/SECURITY_STANDARDS.md and .claude/ENVIRONMENT_GUIDE.md

# Application environment: development | staging | production.
# Controls secure defaults (token TTLs, error verbosity, rate limits).
APP_ENV=development

# Server bind address and port
PORT=3000
HOST=0.0.0.0

# Database — replace with real connection string in .env
DATABASE_URL=postgresql://user:password@localhost:5432/app_dev

# Postgres container credentials used by docker-compose (dev-only defaults;
# production .env must override these)
POSTGRES_USER=secnews
POSTGRES_PASSWORD=secnews_dev_password
POSTGRES_DB=secnews_dev

# Auth
JWT_SECRET=replace-me-with-a-real-secret-in-env
# Session lifetime (e.g. 15m, 4h, 12h). The sidebar countdown reads this expiry.
JWT_EXPIRES_IN=4h

# 32+ byte hex key used to encrypt sensitive credentials at rest
# (integration credentials: SMTP, WhatsApp gateway, AI providers).
# Generate: openssl rand -hex 32
ENCRYPTION_KEY=replace-me-with-64-hex-chars

# Shared secret presented by trusted feed-ingest callers (B-wave ingest API)
INGEST_API_KEY=replace-me-with-a-real-ingest-key

# Messaging/Email now via Integration menu (DB-backed, encrypted) — no env
# needed; see Integrations page in the web UI (ADMIN role). WAHA_BASE_URL /
# SMTP_* env vars still work as a code-level fallback but are not required.

# Feed polling schedule in node-cron format (RSS/Atom ingest worker cadence).
# Default: every 15 minutes.
FEED_POLL_CRON="*/15 * * * *"

# CORS — comma-separated list of allowed browser origins (no trailing slash).
# Empty/unset disables cross-origin browser access entirely (secure default).
CORS_ORIGIN=http://localhost:5173

# External services — uncomment/add as stack becomes known
# REDIS_URL=redis://localhost:6379
