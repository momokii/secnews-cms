// SecNews CMS — full domain schema (Prisma 7, prisma-client generator, driver adapters).
// Conventions: camelCase fields, no @map anywhere, datasource URL lives in prisma.config.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  EDITOR
  ANALYST
}

enum FeedItemStatus {
  UNREVIEWED
  VIEWED
  TAKEN
}

enum TicketOrigin {
  AUTO_FEED
  MANUAL
}

enum TicketStatus {
  OPEN
  RESEARCH
  READY
  SENT
  CLOSED
}

enum FindingType {
  VULNERABILITY_CVE
  THREAT_CAMPAIGN
  OTHER
}

enum IocType {
  DOMAIN
  IPV4
  IPV6
  URL
  EMAIL
  MD5
  SHA1
  SHA256
  FILEPATH
  MUTEX
  CIDR
  OTHER
}

enum ChannelType {
  WHATSAPP
  TELEGRAM
  EMAIL
}

enum TlpLevel {
  CLEAR
  GREEN
  AMBER
  RED
}

/** Ticket audit-trail actions (TASK-ACT). One TicketActivity row per event. */
enum TicketActivityAction {
  CREATED
  TAKEN
  STATUS_CHANGED
  FIELDS_UPDATED
  IOC_ADDED
  IOC_UPDATED
  IOC_REMOVED
  SOURCE_ADDED
  SOURCE_UPDATED
  SOURCE_REMOVED
  AI_FILL
  AI_ENRICH
  AI_SOURCE_DRAFT
  SUGGESTION_ACCEPTED
  SUGGESTION_REJECTED
  SUGGESTION_DELETED
  SENT
  OTX_PUSHED
}

enum SuggestionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum DeliveryStatus {
  SENT
  FAILED
}

enum IntegrationKind {
  OPENAI
  ANTHROPIC
  GEMINI
  DEEPSEEK
  OTX
  SMTP
  WAHA
}

/** TASK-PROMPT: which AI flow a stored prompt template drives. */
enum PromptKind {
  FILL
  ENRICH
  SOURCE_DRAFT
}

// ── Models ───────────────────────────────────────────────────────────────────

model User {
  id           String          @id @default(uuid())
  email        String          @unique
  passwordHash String
  name         String
  role         Role
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sources      TicketSource[]
  iocs         Ioc[]
  activities   TicketActivity[]
  ticketsTaken Ticket[]         @relation("TicketTakenBy")
  promptRevisions PromptRevision[]
}

model FeedSource {
  id        String   @id @default(uuid())
  name      String
  url       String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  items     FeedItem[]
}

model FeedItem {
  id         String         @id @default(uuid())
  feedId     String
  feed       FeedSource     @relation(fields: [feedId], references: [id])
  guid       String
  title      String
  url        String?
  publishedAt DateTime?
  status     FeedItemStatus @default(UNREVIEWED)
  raw        Json
  ticket     Ticket?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@unique([feedId, guid])
}

model Ticket {
  id            String      @id @default(uuid())
  feedItemId    String?     @unique
  feedItem      FeedItem?   @relation(fields: [feedItemId], references: [id])
  takenById     String?
  takenBy       User?       @relation("TicketTakenBy", fields: [takenById], references: [id], onDelete: SetNull)
  title         String
  summary       String
  origin        TicketOrigin
  status        TicketStatus @default(OPEN)
  findingType   FindingType
  tlp           TlpLevel    @default(AMBER)
  recommendation String?
  // Final (client-facing) output fields — edited via PATCH fields / AI suggestion
  // accept (C4); structured per finding type.
  overview        String?
  description     String?
  recommendations String?
  cveIds          String[]
  affectedProduct String?
  affectedVersions String?
  mitigation      String?
  threatName      String?
  references    String[]
  otxPulseId    String?
  otxPulseUrl   String?
  sources       TicketSource[]
  iocs          Ioc[]
  suggestions   AiSuggestion[]
  deliveries    DeliveryAudit[]
  activities    TicketActivity[]
  createdAt     DateTime    @default(now())
  updatedAt     DateTime @updatedAt
}

model TicketSource {
  id          String   @id @default(uuid())
  ticketId    String
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  url         String?
  note        String?
  /// Non-URL label for sources that have no link (PDF name, Slack thread, …)
  title       String?
  /// Long-form analyst notes (Postgres text — no length cap at the DB layer; API caps at 5000)
  notes       String?
  createdById String?
  createdBy   User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
}

model Ioc {
  id                String   @id @default(uuid())
  ticketId          String
  ticket            Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  type              IocType
  value             String
  context           String?
  origin            String?
  createdById       String?
  createdBy         User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  includeInBulletin Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@unique([ticketId, type, value])
}

model AiSuggestion {
  id        String           @id @default(uuid())
  ticketId  String
  ticket    Ticket           @relation(fields: [ticketId], references: [id])
  status    SuggestionStatus @default(PENDING)
  // Which AI flow produced the row — separates assist (FILL/ENRICH) from
  // source-grounded drafting in the ticket detail panels.
  origin    PromptKind       @default(FILL)
  model     String?
  provider  String?
  content   String
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
}

model IntegrationConfig {
  id           String          @id @default(uuid())
  kind         IntegrationKind @unique
  encryptedKey String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model Client {
  id           String   @id @default(uuid())
  name         String
  contactEmail String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  channels     Channel[]
}

model Channel {
  id          String          @id @default(uuid())
  clientId    String
  client      Client          @relation(fields: [clientId], references: [id])
  type        ChannelType
  target      String
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deliveries  DeliveryAudit[]
}

model DeliveryAudit {
  id        String         @id @default(uuid())
  ticketId  String
  ticket    Ticket         @relation(fields: [ticketId], references: [id])
  channelId String
  channel   Channel        @relation(fields: [channelId], references: [id])
  status    DeliveryStatus
  error     String?
  // TASK-D1: compliance fields — exact rendered body and sending actor.
  payload   String
  sentById  String
  createdAt DateTime       @default(now())
}

model BulletinTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String?
  body      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// HTML email template for EMAIL-channel deliveries. Single org-wide row pinned
// to name "default" (same pattern as BulletinTemplate); until an ADMIN stores
// one, senders fall back to the built-in default in
// src/modules/email-template/render.ts.
model EmailTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String
  htmlBody  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// TASK-PROMPT: ADMIN-managed AI prompt template per flow. `kind` is unique —
// exactly one row per FILL/ENRICH. Seeded by migration with security-intelligence
// drafting defaults; a missing row falls back to the built-in
// default (src/modules/ai/prompt-template.ts).
model PromptTemplate {
  id        String     @id @default(uuid())
  kind      PromptKind @unique
  content   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model PromptRevision {
  id         String     @id @default(uuid())
  promptKind PromptKind
  content    String
  actorId    String?
  actor      User?      @relation(fields: [actorId], references: [id], onDelete: SetNull)
  createdAt  DateTime   @default(now())

  @@index([promptKind, createdAt])
}

// TASK-ACT: append-only audit trail of every ticket change. actorId is
// nullable because system-originated events have no user (future ingest).
model TicketActivity {
  id        String               @id @default(uuid())
  ticketId  String
  ticket    Ticket               @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?                @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action    TicketActivityAction
  detail    String?
  createdAt DateTime             @default(now())

  @@index([ticketId, createdAt])
}
